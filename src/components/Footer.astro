---
import { site, withReferral } from '../config/site';
import Wordmark from './Wordmark.astro';
const year = new Date().getFullYear();
const { contact, social } = site;
const exploreLinks = site.nav.filter((n) => n.href !== '/');

// A page-relevant line icon for each nav destination (inner SVG markup; the
// <svg> wrapper supplies the shared stroke styling). Add a row here if the nav
// gains a page — an unmapped href just renders without an icon.
const navIcons: Record<string, string> = {
  '/people': '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  '/research': '<path d="M10 2v7.31"/><path d="M14 9.3V2"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.52 16h12.96"/>',
  '/publications': '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v5h5"/><path d="M9 13h6"/><path d="M9 17h6"/>',
  '/data': '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/>',
  '/news': '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>',
  '/contact': '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
};
---

<footer class="site-footer">
  <div class="container">
    <!-- Brand band -->
    <div class="foot-top">
      <div class="foot-brand">
        <a href="/" class="foot-mark"><Wordmark /></a>
        <p class="foot-tagline">Studying the genomic drivers of breast cancer development, progression, and metastasis.</p>
      </div>
      <ul class="social" aria-label="Social links">
        <li>
          <a href={social.bluesky} rel="me noopener" aria-label="Eran Andrechek on BlueSky">
            <svg viewBox="0 0 600 530" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M135 75c66 50 137 151 163 205 26-54 97-155 163-205 48-36 125-64 125 24 0 18-10 148-16 169-21 73-95 91-161 80 115 20 145 85 81 150-120 123-173-31-187-66-2-5-4-7-4-2 0-5-2 0-4 2-14 35-67 189-187 66-64-65-34-130 81-150-66 11-140-7-161-80-6-21-16-151-16-169 0-88 77-60 125-24Z"/></svg>
          </a>
        </li>
        <li>
          <a href={social.linkedin} rel="me noopener" aria-label="Eran Andrechek on LinkedIn">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        </li>
        <li>
          <a href={social.github} rel="me noopener" aria-label="Andrechek Lab on GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <!-- Evenly-weighted columns, one shared rhythm -->
    <div class="foot-cols">
      <nav class="foot-col foot-nav" aria-label="Site sections">
        <p class="foot-heading">Explore</p>
        <ul class="foot-list">
          {exploreLinks.map((n) => (
            <li class="foot-row">
              <svg class="foot-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={navIcons[n.href] ?? ''} />
              <a href={n.href}>{n.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <address class="foot-col">
        <p class="foot-heading">Visit</p>
        <ul class="foot-list">
          <li class="foot-row foot-row--top">
            <svg class="foot-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/>
            </svg>
            <span>{contact.address.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}</span>
          </li>
          <li class="foot-row">
            <svg class="foot-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4"/>
            </svg>
            {contact.departmentUrl ? (
              <a class="foot-ext" href={withReferral(contact.departmentUrl, 'footer')} referrerpolicy="strict-origin-when-cross-origin">{contact.department}</a>
            ) : (
              <span>{contact.department}</span>
            )}
          </li>
          <li class="foot-row">
            <svg class="foot-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.42 10.92a1 1 0 0 0-.02-1.83L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.84l8.57 3.9a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>
            </svg>
            <a class="foot-ext" href={withReferral(site.msu.url, 'footer')} referrerpolicy="strict-origin-when-cross-origin">{site.institution}</a>
          </li>
        </ul>
      </address>

      <div class="foot-col">
        <p class="foot-heading">Get in touch</p>
        <ul class="foot-list">
          <li class="foot-row">
            <svg class="foot-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6 9 6 9-6"/>
            </svg>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
          {contact.phones.map((p) => (
            <li class="foot-row">
              <svg class="foot-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.69 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.74-1.74a2 2 0 0 1 2.11-.45c.74.33 1.53.56 2.34.69A2 2 0 0 1 22 16.92Z"/>
              </svg>
              <span class="foot-static">{p.number} <span class="foot-tag">{p.label}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="foot-base">
      <p>© {year} {site.name}</p>
      <p><a href={social.github} rel="noopener">Open-source on GitHub</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--brand-deep);
    color: var(--footer-muted);
    padding-block: clamp(3.5rem, 6vw, 4.75rem) 1.9rem;
  }

  /* ---- Brand band ---- */
  .foot-top {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 2rem; flex-wrap: wrap;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid color-mix(in srgb, #fff 12%, transparent);
  }
  .foot-mark { color: #fff; font-size: 1.7rem; display: inline-block; }
  .foot-mark:hover { text-decoration: none; opacity: 0.85; }
  .foot-tagline {
    margin-top: 0.85rem; max-width: 30rem;
    font-size: 0.97rem; line-height: 1.6; color: var(--footer-muted);
  }
  .social { list-style: none; display: flex; gap: 0.6rem; padding: 0; margin: 0.4rem 0 0; flex: none; }
  .social a {
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem;
    border-radius: 50%; color: var(--footer-muted);
    border: 1px solid color-mix(in srgb, #fff 16%, transparent);
    transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
  }
  .social a:hover { background: #fff; color: var(--brand-deep); border-color: #fff; transform: translateY(-2px); }

  /* ---- Columns: identical rhythm everywhere ---- */
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem clamp(2rem, 4vw, 3.5rem);
    margin-top: 2.5rem;
  }
  .foot-col { font-style: normal; }
  .foot-heading {
    font-family: var(--font-mono); font-weight: 500; color: #fff;
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem;
    margin: 0 0 1.25rem;
  }
  .foot-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.8rem; }
  /* Static info (address lines, phone numbers) reads muted… */
  .foot-list li { font-size: 0.95rem; line-height: 1.5; color: var(--footer-muted); }
  /* …links read brighter so it's obvious they're clickable — no underlines. */
  .foot-list a {
    display: inline-flex; align-items: center; gap: 0.35rem;
    color: color-mix(in srgb, var(--brand) 8%, #fff);
    text-decoration: none; transition: color 0.15s ease;
  }
  .foot-list a:hover { color: #fff; }
  .foot-tag {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--footer-faint);
  }

  /* Explore = navigation: a → slides in on hover to reinforce "these are links". */
  .foot-nav .foot-list a::after {
    content: '→'; font-size: 0.9em;
    opacity: 0; transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .foot-nav .foot-list a:hover::after { opacity: 0.85; transform: none; }

  /* External links (department, university) carry a persistent ↗. */
  .foot-ext::after { content: '↗'; font-size: 0.82em; opacity: 0.6; }

  /* Each row carries its own small icon — page-relevant in Explore, and
     pin / building / cap / mail / phone elsewhere — so every item is legible
     at a glance and the columns line up. */
  .foot-row { display: flex; align-items: center; gap: 0.6rem; }
  .foot-row--top { align-items: flex-start; }
  .foot-ico { flex: none; color: var(--footer-faint); }
  .foot-row--top .foot-ico { margin-top: 0.2rem; }

  /* ---- Base line ---- */
  .foot-base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.25rem); padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #fff 12%, transparent);
    font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.02em; color: var(--footer-faint);
  }
  .foot-base a { color: var(--footer-muted); text-decoration: none; }
  .foot-base a:hover { color: #fff; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 680px) {
    .foot-cols { grid-template-columns: 1fr 1fr; gap: 2.25rem 2rem; }
  }
  @media (max-width: 420px) {
    .foot-cols { grid-template-columns: 1fr; }
  }
</style>
