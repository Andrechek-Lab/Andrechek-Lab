---
import { site, withReferral } from '../config/site';
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const { departmentUrl } = site.contact;
---

<header class="site-header">
  <!-- Institutional utility strip (desktop) -->
  <div class="topbar">
    <div class="container topbar__inner">
      <a class="topbar__link" href={withReferral(site.msu.url, 'header')} referrerpolicy="strict-origin-when-cross-origin">{site.msu.name}</a>
      {departmentUrl ? (
        <a class="topbar__link topbar__dept" href={withReferral(departmentUrl, 'header')} referrerpolicy="strict-origin-when-cross-origin">{site.contact.department}</a>
      ) : (
        <span class="topbar__dept">{site.contact.department}</span>
      )}
      <a class="topbar__link topbar__mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
  </div>

  <!-- Main navigation bar -->
  <div class="navbar">
    <div class="container bar">
      <a class="wordmark" href="/"><Wordmark /></a>

      <button class="burger" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="primary-nav">
        <span></span><span></span><span></span>
      </button>

      <nav id="primary-nav" class="nav" aria-label="Primary">
        <ul>
          {site.nav.map((item) => (
            <li>
              <a href={item.href} class={isActive(item.href) ? 'is-active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="nav__meta">
          <a href={withReferral(site.msu.url, 'menu')} referrerpolicy="strict-origin-when-cross-origin">{site.msu.name}</a>
          {departmentUrl && <a href={withReferral(departmentUrl, 'menu')} referrerpolicy="strict-origin-when-cross-origin">{site.contact.department}</a>}
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </div>
      </nav>
    </div>
  </div>

  <div class="nav-scrim" aria-hidden="true"></div>
</header>

<script>
  // The header persists across view-transition navigations, so listeners are
  // wired exactly once; the active link is re-synced on every page load.
  function wireOnce() {
    const header = document.querySelector('.site-header') as HTMLElement | null;
    const burger = header?.querySelector('.burger');
    if (!header || !burger || header.dataset.wired) return;
    header.dataset.wired = '1';
    const close = () => {
      header.classList.remove('nav-open');
      burger.setAttribute('aria-expanded', 'false');
    };
    burger.addEventListener('click', () => {
      const open = header.classList.toggle('nav-open');
      burger.setAttribute('aria-expanded', String(open));
    });
    header.querySelector('.nav-scrim')?.addEventListener('click', close);
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', close));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }

  function syncActiveLink() {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const path = location.pathname.replace(/\/+$/, '') || '/';
    header.querySelectorAll('.nav ul a').forEach((a) => {
      const href = a.getAttribute('href') || '';
      const active = href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
      a.classList.toggle('is-active', active);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', () => { wireOnce(); syncActiveLink(); });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; }

  /* ---- Institutional utility strip (lighter official green) ---- */
  .topbar { background: var(--brand); color: color-mix(in srgb, #fff 70%, var(--brand)); }
  .topbar__inner {
    display: flex; align-items: center; gap: 1.1rem;
    min-height: var(--topbar-h);
    font-family: var(--font-mono);
    font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .topbar__link { color: color-mix(in srgb, #fff 84%, var(--brand)); text-decoration: none; }
  .topbar__link:hover { color: #fff; text-decoration: underline; text-underline-offset: 2px; }
  .topbar__dept { color: color-mix(in srgb, #fff 60%, var(--brand)); }
  .topbar__mail { margin-left: auto; }

  /* ---- Main bar ---- */
  .navbar {
    position: relative;
    z-index: 2; /* keep the bar (and the menu panel it contains) above the scrim */
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    min-height: var(--nav-h); gap: 1rem;
  }

  /* Text wordmark (two-tone handled by the shared Wordmark component) */
  .wordmark { color: var(--brand); font-size: 1.42rem; }
  .wordmark:hover { color: var(--brand); text-decoration: none; opacity: 0.85; }

  /* Desktop nav */
  .nav { display: flex; align-items: center; gap: 1.25rem; }
  .nav ul {
    list-style: none; display: flex; flex-wrap: nowrap; align-items: center;
    gap: 0.1rem; padding: 0;
  }
  .nav a {
    position: relative; display: inline-block; white-space: nowrap;
    padding: 0.45rem 0.72rem; border-radius: var(--radius-sm);
    color: var(--body); font-weight: 500; font-size: 0.95rem;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav a:hover { background: var(--brand-tint); color: var(--brand-dark); text-decoration: none; }
  .nav a.is-active { color: var(--brand); font-weight: 600; }
  .nav a.is-active::after {
    content: ''; position: absolute;
    left: 0.72rem; right: 0.72rem; bottom: 0.02rem;
    height: 2px; background: var(--brand); border-radius: 2px;
  }
  .nav__meta { display: none; }

  /* Burger */
  .burger {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 44px; height: 44px; background: none; border: none; cursor: pointer; padding: 10px;
    z-index: 2;
  }
  .burger span {
    display: block; height: 2px; width: 100%; background: var(--brand); border-radius: 2px;
    transition: transform 0.24s ease, opacity 0.24s ease;
  }

  /* Scrim behind the mobile menu (sits below the navbar, above page content) */
  .nav-scrim {
    position: fixed; inset: 0; z-index: 1;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    opacity: 0; visibility: hidden;
    transition: opacity 0.24s ease, visibility 0.24s ease;
  }

  /* ============ Mobile ============ */
  @media (max-width: 940px) {
    .topbar { display: none; }
    .burger { display: flex; }

    .nav {
      position: fixed; inset: var(--nav-h) 0 auto 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: color-mix(in srgb, var(--bg) 96%, #fff);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 0.6rem 0.6rem 0.85rem;
      transform: translateY(-8px);
      opacity: 0; visibility: hidden;
      transition: transform 0.22s ease, opacity 0.22s ease, visibility 0.22s ease;
      max-height: calc(100dvh - var(--nav-h));
      overflow-y: auto;
      z-index: 10;
    }
    .nav ul { flex-direction: column; align-items: stretch; gap: 0.15rem; }
    .nav a {
      display: flex; align-items: center;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 1.05rem; font-weight: 500; color: var(--body);
      white-space: normal;
      transition: background 0.14s ease, color 0.14s ease;
    }
    .nav a:hover, .nav a:focus-visible { background: var(--brand-tint); color: var(--brand-dark); }
    .nav a.is-active {
      color: var(--brand); font-weight: 600; background: var(--brand-tint);
      box-shadow: inset 3px 0 0 var(--brand);
    }
    .nav a.is-active::after { display: none; }

    .nav__meta {
      display: flex; flex-direction: column; gap: 0.7rem;
      margin: 0.85rem 0.4rem 0; padding: 1.1rem 0.6rem 0.2rem;
      border-top: 1px solid var(--border);
      font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.04em;
    }
    .nav__meta a { color: var(--muted); }
    .nav__meta a:hover { color: var(--brand); text-decoration: none; }

    .site-header.nav-open .nav { transform: none; opacity: 1; visibility: visible; }
    .site-header.nav-open .nav-scrim { opacity: 1; visibility: visible; }
    .site-header.nav-open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .site-header.nav-open .burger span:nth-child(2) { opacity: 0; }
    .site-header.nav-open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
