---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide { image: ImageMetadata; caption: string }
interface Props { slides: Slide[] }
const { slides } = Astro.props;
---

<div class="slideshow" aria-roledescription="carousel" aria-label="Lab images">
  <div class="slides">
    {slides.map((s, i) => (
      <figure class="slide" data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <Image src={s.image} alt={s.caption} widths={[600, 1000, 1400]} sizes="(max-width: 1000px) 100vw, 1000px" loading={i === 0 ? 'eager' : 'lazy'} />
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))}
  </div>

  <button class="nav prev" aria-label="Previous image">‹</button>
  <button class="nav next" aria-label="Next image">›</button>

  <div class="dots" role="tablist">
    {slides.map((_, i) => (
      <button class="dot" data-dot={i} role="tab" aria-label={`Go to image ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'}></button>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('.slideshow');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll('.slide'));
    const dots = Array.from(root.querySelectorAll('.dot'));
    let idx = 0;
    let timer = null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(n) {
      idx = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('is-active', i === idx);
        s.setAttribute('aria-hidden', i === idx ? 'false' : 'true');
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', i === idx ? 'true' : 'false'));
    }
    function next() { show(idx + 1); }
    function prev() { show(idx - 1); }
    function start() { if (!reduce) { stop(); timer = setInterval(next, 5000); } }
    function stop() { if (timer) clearInterval(timer); }

    root.querySelector('.next').addEventListener('click', () => { next(); start(); });
    root.querySelector('.prev').addEventListener('click', () => { prev(); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    show(0);
    start();
  })();
</script>

<style>
  .slideshow { position: relative; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: #000; }
  .slides { position: relative; aspect-ratio: 16 / 10; }
  .slide {
    position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .slide.is-active { opacity: 1; pointer-events: auto; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: #fff; padding: 1.5rem 1rem 0.9rem; font-size: 0.95rem; text-align: center;
  }
  .nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(0,0,0,0.35); color: #fff; border: none; cursor: pointer;
    width: 44px; height: 44px; font-size: 1.6rem; line-height: 1; border-radius: 50%;
    display: grid; place-items: center; transition: background 0.15s ease;
  }
  .nav:hover { background: rgba(0,0,0,0.6); }
  .prev { left: 0.6rem; }
  .next { right: 0.6rem; }
  .dots { position: absolute; bottom: 0.5rem; left: 0; right: 0; display: flex; justify-content: center; gap: 0.4rem; }
  .dot { width: 10px; height: 10px; border-radius: 50%; border: none; background: rgba(255,255,255,0.5); cursor: pointer; padding: 0; }
  .dot[aria-selected='true'] { background: #fff; }
</style>
