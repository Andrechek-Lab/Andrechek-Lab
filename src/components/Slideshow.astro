---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide { image: ImageMetadata; caption: string }
interface Props { slides: Slide[] }
const { slides } = Astro.props;
const total = String(slides.length).padStart(2, '0');
---

<div class="gallery" aria-roledescription="carousel" aria-label="Lab images">
  <div class="gallery__track" data-track tabindex="0">
    {slides.map((s, i) => (
      <figure class="gslide" data-slide={i} aria-label={`${i + 1} of ${slides.length}`}>
        <Image
          src={s.image}
          alt={s.caption}
          widths={[640, 960, 1280]}
          sizes="(max-width: 1000px) 100vw, 1000px"
          priority={i === 0}
          loading={i === 0 ? undefined : 'lazy'}
          decoding="async"
        />
        <figcaption class="gslide__cap">
          <span class="gslide__idx">{String(i + 1).padStart(2, '0')} <span>/ {total}</span></span>
          <span class="gslide__text">{s.caption}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <button class="gnav gnav--prev" data-prev aria-label="Previous image">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button class="gnav gnav--next" data-next aria-label="Next image">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
  </button>

  <div class="gdots" data-dots role="tablist" aria-label="Choose image">
    {slides.map((_, i) => (
      <button class="gdot" data-dot={i} role="tab" aria-label={`Go to image ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'}></button>
    ))}
  </div>
</div>

<script>
  function initGallery() {
    document.querySelectorAll('.gallery').forEach((root) => {
      if ((root as HTMLElement).dataset.ready) return;
      (root as HTMLElement).dataset.ready = '1';

      const track = root.querySelector('[data-track]') as HTMLElement;
      const slides = Array.from(root.querySelectorAll('.gslide'));
      const dots = Array.from(root.querySelectorAll('.gdot'));
      if (!track || !slides.length) return;

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;
      let timer: number | undefined;
      let auto = !reduce;

      const go = (i: number, smooth = true) => {
        current = (i + slides.length) % slides.length;
        track.scrollTo({ left: (slides[current] as HTMLElement).offsetLeft - track.offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
      };
      const setActive = (i: number) => {
        current = i;
        dots.forEach((d, n) => d.setAttribute('aria-selected', String(n === i)));
      };
      const stopAuto = () => { auto = false; if (timer) { clearInterval(timer); timer = undefined; } };
      const startAuto = () => {
        if (reduce || !auto || timer) return;
        timer = window.setInterval(() => go(current + 1), 5500);
      };

      // Track which slide is centered (drives the dots), without layout thrash.
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) setActive(slides.indexOf(e.target)); }),
        { root: track, threshold: 0.6 }
      );
      slides.forEach((s) => io.observe(s));

      root.querySelector('[data-prev]')?.addEventListener('click', () => { stopAuto(); go(current - 1); });
      root.querySelector('[data-next]')?.addEventListener('click', () => { stopAuto(); go(current + 1); });
      dots.forEach((d, i) => d.addEventListener('click', () => { stopAuto(); go(i); }));
      track.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') { stopAuto(); go(current - 1); }
        if (e.key === 'ArrowRight') { stopAuto(); go(current + 1); }
      });

      root.addEventListener('pointerenter', () => { if (timer) { clearInterval(timer); timer = undefined; } });
      root.addEventListener('pointerleave', () => startAuto());
      track.addEventListener('pointerdown', stopAuto, { once: true });
      startAuto();
    });
  }
  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .gallery { position: relative; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); background: var(--brand-deep); }
  .gallery__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    aspect-ratio: 16 / 9;
  }
  .gallery__track::-webkit-scrollbar { display: none; }
  .gallery__track:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }

  .gslide { position: relative; flex: 0 0 100%; scroll-snap-align: center; margin: 0; }
  .gslide img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .gslide__cap {
    position: absolute; inset: auto 0 0 0;
    display: flex; flex-direction: column; gap: 0.3rem;
    padding: 2.5rem 1.4rem 1.2rem;
    background: linear-gradient(transparent, color-mix(in srgb, var(--brand-deep) 92%, #000) 92%);
    color: #fff;
  }
  .gslide__idx {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em;
    color: color-mix(in srgb, #fff 78%, var(--brand));
  }
  .gslide__idx span { opacity: 0.65; }
  .gslide__text { font-size: 0.98rem; font-weight: 500; line-height: 1.4; max-width: 46ch; }

  .gnav {
    position: absolute; top: calc(50% - 1.5rem); transform: translateY(-50%);
    display: grid; place-items: center;
    width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: color-mix(in srgb, var(--brand-deep) 55%, transparent);
    backdrop-filter: blur(4px);
    color: #fff; border: 1px solid color-mix(in srgb, #fff 28%, transparent);
    cursor: pointer; opacity: 0; transition: opacity 0.2s ease, background 0.2s ease;
  }
  .gallery:hover .gnav, .gnav:focus-visible { opacity: 1; }
  .gnav:hover { background: var(--brand); }
  .gnav--prev { left: 0.8rem; }
  .gnav--next { right: 0.8rem; }

  .gdots {
    position: absolute; left: 0; right: 0; bottom: 0.35rem;
    display: flex; justify-content: center; gap: 0;
  }
  /* 24×24 hit target (WCAG 2.5.8) with a small visual dot drawn inside. */
  .gdot {
    width: 24px; height: 24px; padding: 0; cursor: pointer;
    border: none; background: none; display: grid; place-items: center;
  }
  .gdot::before {
    content: ''; width: 7px; height: 7px; border-radius: 999px;
    background: color-mix(in srgb, #fff 45%, transparent);
    transition: width 0.2s ease, background 0.2s ease;
  }
  .gdot[aria-selected='true']::before { width: 22px; background: #fff; }

  @media (hover: none) {
    .gnav { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__track { scroll-behavior: auto; }
  }
</style>
