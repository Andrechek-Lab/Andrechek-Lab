---
/**
 * The lab wordmark — one source of truth so the header and footer always match.
 * The name comes from site.shortName: the last word renders lighter, the rest
 * bold (e.g. "Andrechek Lab" → **Andrechek** Lab). Inherits color and font-size
 * from its parent (set those on the wrapper); the two-tone weight is baked in.
 */
import { site } from '../config/site';
const parts = site.shortName.trim().split(/\s+/);
const secondary = parts.length > 1 ? parts.pop() : '';
const primary = parts.join(' ');
---

<span class="wm"><span class="wm__a">{primary}</span>{secondary && <span class="wm__b">{secondary}</span>}</span>

<style>
  .wm { font-family: var(--font-display); letter-spacing: -0.02em; white-space: nowrap; }
  .wm__a { font-weight: 600; }
  .wm__b { font-weight: 400; margin-left: 0.32em; opacity: 0.72; }
</style>
