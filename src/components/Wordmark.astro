---
/**
 * The lab wordmark — one source of truth so the header and footer always match.
 * Inherits color and font-size from its parent (set those on the wrapper);
 * the two-tone weight is baked in here.
 */
---

<span class="wm"><span class="wm__a">Andrechek</span><span class="wm__b">Lab</span></span>

<style>
  .wm { font-family: var(--font-display); letter-spacing: -0.02em; white-space: nowrap; }
  .wm__a { font-weight: 600; }
  .wm__b { font-weight: 400; margin-left: 0.32em; opacity: 0.72; }
</style>
