---
// Self-hosted fonts (Fontsource — no third-party CDN, no FOUT).
// The whole site uses the IBM Plex superfamily: Serif (display), Sans (body),
// Mono (labels/metadata).
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/500.css';
import '@fontsource/ibm-plex-serif/600.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
// Preload the two above-the-fold fonts (body sans + the serif H1 weight) so the
// hero text isn't the LCP waiting on a late font swap.
import sansBody from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import serifTitle from '@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-500-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Path (e.g. "/people") used for the canonical URL; defaults to the current page. */
  ogImage?: string;
}

const { title, description = site.description, ogImage } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.institution}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Every page gets a social-share image (defaults to the generated /og.png).
const ogImageUrl = new URL(ogImage ?? site.ogImage, site.url).href;
const ogImageAlt = `${site.name} — ${site.institution}`;
const { ga4, cloudflareToken } = site.analytics;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: site.name,
  url: site.url,
  parentOrganization: { '@type': 'CollegeOrUniversity', name: site.institution, url: site.institutionUrl },
  description: site.description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={sansBody} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifTitle} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social cards (iMessage, Slack, Facebook, LinkedIn, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Smooth, flash-free navigation between pages -->
    <ClientRouter />

    <!-- UI glue: freeze transitions mid-resize, and play entrance
         animations only on a fresh load (not on in-session navigations). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var t;
        addEventListener('resize', function () {
          root.classList.add('is-resizing');
          clearTimeout(t);
          t = setTimeout(function () { root.classList.remove('is-resizing'); }, 150);
        });
        function applyVT() { if (sessionStorage.getItem('vt-seen')) root.classList.add('vt-seen'); }
        applyVT();
        addEventListener('astro:after-swap', applyVT);
        addEventListener('astro:page-load', function () { sessionStorage.setItem('vt-seen', '1'); });
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics (GA4) — queue the pageview immediately, but defer the
         67 KB gtag.js until the browser is idle so it doesn't compete with the
         hero fonts during the critical load (dataLayer replays once it loads). -->
    {ga4 && (
      <script is:inline define:vars={{ ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', ga4);
        var loadGA = function () {
          if (window.__gaLoaded) return; window.__gaLoaded = 1;
          var s = document.createElement('script');
          s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
          document.head.appendChild(s);
        };
        if ('requestIdleCallback' in window) requestIdleCallback(loadGA, { timeout: 5000 });
        else addEventListener('load', function () { setTimeout(loadGA, 1500); });
      </script>
    )}

    <!-- Cloudflare Web Analytics (privacy-friendly; no cookies) -->
    {cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cloudflareToken}"}`}
      ></script>
    )}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header transition:persist />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
