---
// Self-hosted fonts (Fontsource — no third-party CDN, no FOUT).
// The whole site uses the IBM Plex superfamily: Serif (display), Sans (body),
// Mono (labels/metadata).
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/500.css';
import '@fontsource/ibm-plex-serif/600.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Path (e.g. "/people") used for the canonical URL; defaults to the current page. */
  ogImage?: string;
}

const { title, description = site.description, ogImage } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.institution}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, site.url).href : undefined;
const { ga4, cloudflareToken } = site.analytics;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: site.name,
  url: site.url,
  parentOrganization: { '@type': 'CollegeOrUniversity', name: site.institution, url: site.msu.url },
  description: site.description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Smooth, flash-free navigation between pages -->
    <ClientRouter />

    <!-- UI glue: freeze transitions mid-resize, and play entrance
         animations only on a fresh load (not on in-session navigations). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var t;
        addEventListener('resize', function () {
          root.classList.add('is-resizing');
          clearTimeout(t);
          t = setTimeout(function () { root.classList.remove('is-resizing'); }, 150);
        });
        function applyVT() { if (sessionStorage.getItem('vt-seen')) root.classList.add('vt-seen'); }
        applyVT();
        addEventListener('astro:after-swap', applyVT);
        addEventListener('astro:page-load', function () { sessionStorage.setItem('vt-seen', '1'); });
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics (GA4) -->
    {ga4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4);
        </script>
      </>
    )}

    <!-- Cloudflare Web Analytics (privacy-friendly; no cookies) -->
    {cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cloudflareToken}"}`}
      ></script>
    )}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header transition:persist />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
