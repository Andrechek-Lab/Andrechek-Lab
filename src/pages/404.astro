---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy } from '../lib/copy';
const copy = await getCopy('notfound');
---

<BaseLayout title={copy.title}>
  <section class="section">
    <div class="container notfound">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lede">{copy.lede}</p>
      <p><a class="btn" href="/">{copy.text?.back}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { text-align: center; padding-block: 3rem; }
  .lede { font-size: 1.15rem; color: var(--muted); margin: 0.5rem 0 1.5rem; }
</style>
