---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { getCopy } from '../lib/copy';
const { contact } = site;
const copy = await getCopy('contact');
---

<BaseLayout title={copy.eyebrow} description={copy.meta}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>

      <div class="card">
        <p class="name">{contact.name}</p>
        <p class="role">{contact.title} · {site.department}<br />{site.institution}</p>
        <address>
          {contact.address.map((line) => (<span>{line}<br /></span>))}
        </address>
        <p class="lines">
          <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
          {contact.phones.map((p) => (
            <span><a href={`tel:${p.number.replace(/[^0-9]/g, '')}`}>{p.number}</a> ({p.label})<br /></span>
          ))}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .card {
    margin-top: 1.5rem; max-width: 32rem;
    background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--brand);
    border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.85rem;
  }
  .name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; letter-spacing: -0.015em; color: var(--ink); }
  .role { color: var(--muted); font-weight: 600; margin: 0.25rem 0 1rem; }
  address { font-style: normal; color: var(--body); margin-bottom: 1rem; }
  .lines { line-height: 1.9; }
</style>
