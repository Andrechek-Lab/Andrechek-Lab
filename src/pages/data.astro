---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = (await getCollection('datasets')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(groups.map(async (g) => ({ entry: g, Content: (await render(g)).Content })));
const ext = (href: string) => (href.split('.').pop() || 'file').toUpperCase().slice(0, 4);
---

<BaseLayout title="Supplemental Data" description="Supplemental data and detailed methods for Andrechek Lab manuscripts, provided for transparency and reproducibility.">
  <section class="section">
    <div class="container prose-wide">
      <p class="eyebrow">Supplemental Data</p>
      <h1>Supplemental Data</h1>
      <p class="lede">
        Supplemental information detailing the methods used to generate our genomic analyses is provided for the manuscripts below. We share this to preserve transparency in our research methods and to provide a resource for anyone seeking to reproduce our data.
      </p>

      {rendered.map(({ entry, Content }) => (
        <article class="dataset">
          <header class="dataset__head">
            <div>
              <h2>{entry.data.title}</h2>
              <p class="dataset__authors">{entry.data.authors}</p>
            </div>
            <span class="dataset__count">{entry.data.files.length} file{entry.data.files.length === 1 ? '' : 's'}</span>
          </header>
          <div class="intro"><Content /></div>
          <ul class="files">
            {entry.data.files.map((f) => (
              <li>
                <a class="file" href={f.href} download>
                  <span class="file__type">{ext(f.href)}</span>
                  <span class="file__main">
                    <span class="file__label">{f.label}</span>
                    {f.description && <span class="file__desc">{f.description}</span>}
                  </span>
                  <span class="file__meta">
                    {f.size && <span class="file__size">{f.size}</span>}
                    <span class="file__dl" aria-hidden="true">↓</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .prose-wide { max-width: 58rem; }
  .lede { font-size: 1.1rem; color: var(--body); margin: 0.5rem 0 0; }

  .dataset {
    margin-top: 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .dataset__head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
    padding-bottom: 1rem; margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .dataset__head h2 { font-size: 1.3rem; }
  .dataset__authors { color: var(--muted); font-size: 0.95rem; margin-top: 0.3rem; }
  .dataset__count {
    flex: none;
    font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--accent); padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-strong); border-radius: 999px; white-space: nowrap;
  }
  .intro { color: var(--body); margin-bottom: 1.25rem; }

  .files { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .file {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.85rem 1rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--ink);
    transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
  }
  .file:hover { border-color: var(--brand); background: var(--brand-tint); text-decoration: none; transform: translateX(3px); }
  .file__type {
    flex: none; display: grid; place-items: center;
    width: 3rem; height: 2.6rem; border-radius: var(--radius-sm);
    background: var(--brand); color: #fff;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.04em;
  }
  .file__main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .file__label { font-weight: 600; }
  .file__desc { color: var(--muted); font-size: 0.9rem; margin-top: 0.1rem; }
  .file__meta { flex: none; display: flex; align-items: center; gap: 0.9rem; }
  .file__size { font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); }
  .file__dl {
    display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--surface); border: 1px solid var(--border-strong); color: var(--brand); font-weight: 700;
  }
  .file:hover .file__dl { background: var(--brand); color: #fff; border-color: var(--brand); }

  @media (max-width: 560px) {
    .file__desc { display: none; }
  }
</style>
