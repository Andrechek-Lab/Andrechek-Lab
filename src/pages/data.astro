---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = (await getCollection('datasets')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(groups.map(async (g) => ({ entry: g, Content: (await render(g)).Content })));
---

<BaseLayout title="Supplemental Data" description="Supplemental data and detailed methods for Andrechek Lab manuscripts, provided for transparency and reproducibility.">
  <section class="section">
    <div class="container prose-wide">
      <p class="eyebrow">Supplemental Data</p>
      <h1>Supplemental Data</h1>
      <p class="lede">
        Supplemental information detailing the methods used to generate our genomic analyses is
        provided for the manuscripts below. We share this to preserve transparency in our research
        methods and to provide a resource for anyone seeking to reproduce our data.
      </p>

      {rendered.map(({ entry, Content }) => (
        <article class="dataset">
          <h2>{entry.data.title}</h2>
          <p class="authors">{entry.data.authors}</p>
          <div class="intro"><Content /></div>
          <ul class="files">
            {entry.data.files.map((f) => (
              <li>
                <a class="file" href={f.href} download>
                  <span class="file__icon" aria-hidden="true">↓</span>
                  <span class="file__main">
                    <span class="file__label">{f.label}{f.size && <span class="file__size"> · {f.size}</span>}</span>
                    {f.description && <span class="file__desc">{f.description}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .prose-wide { max-width: 56rem; }
  .lede { font-size: 1.1rem; color: var(--body); margin: 0.5rem 0 0; }
  .dataset { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 2px solid var(--green-tint); }
  .dataset h2 { font-size: 1.35rem; }
  .authors { color: var(--muted); font-weight: 600; margin: 0.25rem 0 0.5rem; }
  .intro { color: var(--body); margin-bottom: 1rem; }
  .files { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .file {
    display: flex; gap: 0.9rem; align-items: flex-start;
    padding: 0.9rem 1.1rem;
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow-sm); color: var(--ink);
  }
  .file:hover { border-color: var(--green); text-decoration: none; background: var(--green-tint); }
  .file__icon {
    flex: none; width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--green); color: #fff; display: grid; place-items: center; font-weight: 700;
  }
  .file__main { display: flex; flex-direction: column; }
  .file__label { font-weight: 700; }
  .file__size { color: var(--muted); font-weight: 500; }
  .file__desc { color: var(--muted); font-size: 0.92rem; margin-top: 0.15rem; }
</style>
