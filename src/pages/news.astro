---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const coverage = all.filter((n) => n.data.type === 'coverage');
const events = all.filter((n) => n.data.type === 'event');

const fmt = (d: Date) => new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(d);
---

<BaseLayout title="News & Events" description="News coverage and lab events from the Andrechek Lab.">
  <section class="section">
    <div class="container prose-wide">
      <p class="eyebrow">News &amp; Events</p>
      <h1>News &amp; Events</h1>

      <h2>News coverage</h2>
      <ul class="news">
        {coverage.map((n) => (
          <li>
            <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time>
            <p class="news__title">
              {n.data.url ? <a href={n.data.url} rel="noopener">{n.data.title}</a> : n.data.title}
              {n.data.source && <span class="news__source"> · {n.data.source}</span>}
            </p>
          </li>
        ))}
      </ul>

      <h2 class="events-h">Lab events</h2>
      <ul class="news">
        {events.map((n) => (
          <li>
            <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time>
            <p class="news__title">{n.data.title}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-wide { max-width: 56rem; }
  h2 { margin-top: 2rem; }
  .events-h { margin-top: 2.5rem; }
  .news { list-style: none; padding: 0; margin-top: 1rem; display: flex; flex-direction: column; }
  .news li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .news time { color: var(--muted); font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .news__title { font-size: 1.05rem; font-weight: 600; color: var(--ink); }
  .news__source { color: var(--muted); font-weight: 500; font-size: 0.9rem; }

  @media (max-width: 600px) {
    .news li { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
