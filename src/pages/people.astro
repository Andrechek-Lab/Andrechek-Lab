---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { getCopy } from '../lib/copy';
import alumniGroup from '../assets/images/alumni-group.jpeg';

const copy = await getCopy('people');

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const people = await getCollection('people');
const pi = people.filter((p) => p.data.group === 'pi').sort(byOrder);
const current = people.filter((p) => p.data.group === 'current').sort(byOrder);
const alumni = people.filter((p) => p.data.group === 'alumni').sort(byOrder);

// Pre-render the markdown bodies (PI bio + trainee blurbs).
const piCards = await Promise.all(pi.map(async (p) => ({ entry: p, Content: (await render(p)).Content })));
const currentCards = await Promise.all(
  current.map(async (p) => ({ entry: p, Content: (await render(p)).Content }))
);
---

<BaseLayout title={copy.eyebrow} description={copy.meta}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>

      {piCards.map(({ entry, Content }) => (
        <article class="pi">
          {entry.data.photo && (
            <Image class="pi__photo" src={entry.data.photo} alt={entry.data.name} width={320} height={320} />
          )}
          <div class="pi__body">
            <h2>{entry.data.name}</h2>
            <p class="pi__role">{entry.data.title} · {site.department}, {site.institution}</p>
            {entry.data.email && (
              <p class="pi__email"><a href={`mailto:${entry.data.email}`}>{entry.data.email}</a></p>
            )}
            <div class="prose"><Content /></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{current.length} {copy.text?.researchersLabel}</p>
        <h2>{copy.sections?.current?.title}</h2>
      </div>
      <div class="roster">
        {currentCards.map(({ entry, Content }) => (
          <article class="member">
            <div class="member__head">
              {entry.data.photo && (
                <Image class="member__avatar" src={entry.data.photo} alt={entry.data.name} width={160} height={160} />
              )}
              <div class="member__id">
                <h3 class="member__name">{entry.data.name}</h3>
                {entry.data.title && <p class="member__title">{entry.data.title}</p>}
              </div>
            </div>
            <div class="member__blurb"><Content /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{copy.sections?.alumni?.eyebrow}</p>
        <h2>{copy.sections?.alumni?.title}</h2>
      </div>
      <figure class="alumni-figure">
        <Image class="alumni-photo" src={alumniGroup} alt={copy.text?.alumniCaption ?? `${site.name} alumni`} widths={[400, 700]} sizes="(max-width: 520px) 100vw, 440px" />
        <figcaption>{copy.text?.alumniCaption}</figcaption>
      </figure>
      <ul class="alumni">
        {alumni.map((p) => (
          <li class="alumni__item">
            <span class="alumni__name">{p.data.name}</span>
            {p.data.currentPosition && <span class="alumni__where">{p.data.currentPosition}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Principal investigator ---- */
  .pi {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2.5rem;
    margin-top: 1.75rem;
    align-items: start;
  }
  .pi__photo {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    width: 100%;
    height: auto;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .pi__body h2 { margin-bottom: 0.4rem; }
  .pi__role {
    font-family: var(--font-mono);
    font-size: 0.82rem; letter-spacing: 0.02em;
    color: var(--accent); margin-bottom: 0.5rem;
  }
  .pi__email { margin-bottom: 1rem; }
  .pi__body .prose :global(p) { margin-bottom: 0.95rem; max-width: 42rem; }

  /* ---- Current trainees ---- */
  .roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .member {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }
  .member:hover { box-shadow: var(--shadow); transform: translateY(-3px); border-color: var(--border-strong); }
  .member__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .member__avatar {
    width: 68px; height: 68px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    box-shadow: 0 0 0 3px var(--brand-tint);
  }
  .member__name { font-size: 1.15rem; font-weight: 600; line-height: 1.2; }
  .member__title {
    font-family: var(--font-mono);
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--accent); margin-top: 0.3rem;
  }
  .member__blurb { color: var(--body); }
  .member__blurb :global(p) { font-size: 0.95rem; }
  .member__blurb :global(p + p) { margin-top: 0.6rem; }

  /* ---- Alumni ---- */
  .alumni-figure { max-width: 440px; margin: 0.5rem 0 2.25rem; }
  .alumni-photo { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; }
  .alumni-figure figcaption {
    font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--muted); margin-top: 0.6rem;
  }
  .alumni {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0 2.5rem;
    border-top: 1px solid var(--border);
  }
  .alumni__item {
    display: flex; flex-direction: column; gap: 0.1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }
  .alumni__name { font-weight: 600; color: var(--ink); }
  .alumni__where { color: var(--muted); font-size: 0.9rem; }

  @media (max-width: 720px) {
    .pi { grid-template-columns: 1fr; gap: 1.5rem; }
    .pi__photo { max-width: 220px; position: static; }
  }
</style>
