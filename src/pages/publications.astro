---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy } from '../lib/copy';

const pubs = (await getCollection('publications')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.year - a.data.year;
});

// Group into a reverse-chronological timeline by year.
const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
const groups = years.map((year) => ({ year, items: pubs.filter((p) => p.data.year === year) }));
const copy = await getCopy('publications');
---

<BaseLayout title={copy.eyebrow} description={copy.meta}>
  <section class="section">
    <div class="container prose-wide">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lede">{copy.lede}</p>
      {copy.links?.pubmed && (
        <p><a class="btn" href={copy.links.pubmed.href} rel="noopener">{copy.links.pubmed.label}</a></p>
      )}

      <div class="timeline">
        {groups.map(({ year, items }) => (
          <section class="year">
            <h2 class="year__label">{year}</h2>
            <ol class="pubs">
              {items.map((p) => (
                <li class={`pub ${p.data.featured ? 'pub--featured' : ''}`}>
                  {p.data.featured && <span class="pin">{copy.text?.featured}</span>}
                  <h3 class="pub__title"><a href={p.data.url} rel="noopener">{p.data.title}</a></h3>
                  <p class="pub__authors">{p.data.authors}</p>
                  <p class="pub__venue">{p.data.venue}</p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-wide { max-width: 64rem; }
  .lede { font-size: 1.1rem; color: var(--body); margin: 0.5rem 0 1rem; }

  .timeline { margin-top: 2.5rem; display: flex; flex-direction: column; gap: 2.5rem; }
  .year {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .year__label {
    font-family: var(--font-mono);
    font-size: 1.05rem; font-weight: 500;
    color: var(--accent);
    padding-top: 0.35rem;
    position: sticky;
    top: calc(var(--header-h) + 1rem);
  }
  .pubs { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .pub {
    padding: 1.2rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }
  .pub:hover { box-shadow: var(--shadow); transform: translateY(-2px); border-left-color: var(--brand); }
  .pub--featured { border-left-color: var(--accent); }
  .pin {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--accent); margin-bottom: 0.4rem;
  }
  .pin::before { content: '★'; font-size: 0.8em; }
  .pub__title { font-size: 1.12rem; font-weight: 600; line-height: 1.3; margin-bottom: 0.4rem; letter-spacing: -0.01em; }
  .pub__title a { color: var(--ink); }
  .pub__title a:hover { color: var(--brand); }
  .pub__authors { font-weight: 500; color: var(--body); font-size: 0.95rem; }
  .pub__venue { color: var(--muted); font-size: 0.9rem; margin-top: 0.15rem; }

  @media (max-width: 640px) {
    .year { grid-template-columns: 1fr; gap: 0.75rem; }
    .year__label { position: static; padding-top: 0; }
  }
</style>
