---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pubs = (await getCollection('publications')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.year - a.data.year;
});
---

<BaseLayout title="Publications" description="Selected publications from the Andrechek Lab.">
  <section class="section">
    <div class="container prose-wide">
      <p class="eyebrow">Publications</p>
      <h1>Publications</h1>
      <p class="lede">Selected papers from the lab. A complete, always-current list is available on PubMed.</p>
      <p><a class="btn" href="https://www.ncbi.nlm.nih.gov/pubmed/?term=andrechek" rel="noopener">View all Andrechek Lab papers on PubMed →</a></p>

      <ol class="pubs">
        {pubs.map((p) => (
          <li class="pub">
            {p.data.featured && <span class="pin">Featured</span>}
            <h2 class="pub__title"><a href={p.data.url} rel="noopener">{p.data.title}</a></h2>
            <p class="pub__authors">{p.data.authors}</p>
            <p class="pub__venue">{p.data.venue}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-wide { max-width: 60rem; }
  .lede { font-size: 1.1rem; color: var(--body); margin: 0.5rem 0 1rem; }
  .pubs { list-style: none; padding: 0; margin-top: 2rem; display: flex; flex-direction: column; gap: 1.6rem; }
  .pub {
    padding: 1.25rem 1.4rem;
    background: #fff;
    border: 1px solid var(--border);
    border-left: 4px solid var(--green);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .pin {
    display: inline-block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--green-bright); margin-bottom: 0.35rem;
  }
  .pub__title { font-size: 1.18rem; line-height: 1.3; margin-bottom: 0.35rem; }
  .pub__authors { font-weight: 600; color: var(--ink); font-size: 0.97rem; }
  .pub__venue { color: var(--muted); font-size: 0.92rem; margin-top: 0.15rem; }
</style>
