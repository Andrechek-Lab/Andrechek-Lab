---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const areas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const cards = await Promise.all(areas.map(async (a) => ({ entry: a, Content: (await render(a)).Content })));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<BaseLayout title="Research" description="Research in the Andrechek Lab integrates bioinformatics with mouse models of breast cancer to understand cancer initiation, progression, and metastasis.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Research</p>
      <h1>What we study</h1>
      <p class="lede prose">
        The Andrechek Lab is interested in the genomic events that regulate normal development,
        cancer initiation, and progression. We integrate bioinformatics with mouse models of breast
        cancer to ask what mechanisms drive normal tissue to become cancerous.
      </p>

      <nav class="jump" aria-label="Research areas">
        {cards.map(({ entry }, i) => (
          <a href={`#${slug(entry.data.title)}`}>
            <span class="jump__num">{String(i + 1).padStart(2, '0')}</span>
            {entry.data.title}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container areas">
    {cards.map(({ entry, Content }, i) => (
      <section class="area" id={slug(entry.data.title)}>
        <div class="area__media">
          <Image src={entry.data.image} alt={entry.data.title} widths={[400, 720]} sizes="(max-width: 760px) 100vw, 360px" />
        </div>
        <div class="area__text">
          <p class="area__num">{String(i + 1).padStart(2, '0')}</p>
          <h2>{entry.data.title}</h2>
          <p class="summary">{entry.data.summary}</p>
          <div class="prose body"><Content /></div>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .lede { font-size: 1.15rem; margin: 0.75rem 0 0; }

  /* Jump navigation */
  .jump {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .jump a {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 0.9rem; font-weight: 500; color: var(--brand);
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .jump a:hover { background: var(--brand-tint); border-color: var(--brand); text-decoration: none; }
  .jump__num { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); }

  /* Areas */
  .areas { display: flex; flex-direction: column; gap: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2.5rem, 6vw, 5rem); }
  .area {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 2.5rem;
    align-items: start;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--border);
  }
  .area__media { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .area__media img { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; height: auto; }
  .area__num {
    font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.1em;
    color: var(--accent); margin-bottom: 0.4rem;
  }
  .area h2 { margin-bottom: 0.6rem; }
  .summary { font-size: 1.12rem; color: var(--ink); font-weight: 500; margin-bottom: 1rem; }
  .body :global(p) { margin-bottom: 0.85rem; max-width: 42rem; }

  @media (max-width: 760px) {
    .area { grid-template-columns: 1fr; gap: 1.25rem; }
    .area__media { position: static; max-width: 480px; }
  }
</style>
