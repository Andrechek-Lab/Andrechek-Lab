---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const areas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const cards = await Promise.all(areas.map(async (a) => ({ entry: a, Content: (await render(a)).Content })));
---

<BaseLayout title="Research" description="Research in the Andrechek Lab integrates bioinformatics with mouse models of breast cancer to understand cancer initiation, progression, and metastasis.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Research</p>
      <h1>What we study</h1>
      <p class="lede prose">
        The Andrechek Lab is interested in the genomic events that regulate normal development,
        cancer initiation, and progression. We integrate bioinformatics with mouse models of breast
        cancer to ask what mechanisms drive normal tissue to become cancerous.
      </p>

      <div class="areas">
        {cards.map(({ entry, Content }, i) => (
          <article class={`area ${i % 2 ? 'area--flip' : ''}`}>
            <div class="area__media">
              <Image src={entry.data.image} alt={entry.data.title} widths={[400, 700]} sizes="(max-width: 720px) 100vw, 400px" />
            </div>
            <div class="area__text">
              <h2>{entry.data.title}</h2>
              <p class="summary">{entry.data.summary}</p>
              <details>
                <summary>Read more</summary>
                <div class="prose more"><Content /></div>
              </details>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { font-size: 1.15rem; margin: 0.75rem 0 0; }
  .areas { display: flex; flex-direction: column; gap: 2.5rem; margin-top: 2.5rem; }
  .area {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 2rem;
    align-items: start;
  }
  .area--flip { grid-template-columns: 1fr 360px; }
  .area--flip .area__media { order: 2; }
  .area__media img { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; height: auto; }
  .area h2 { margin-bottom: 0.5rem; }
  .summary { font-size: 1.05rem; color: var(--body); }

  details { margin-top: 0.75rem; border-top: 1px solid var(--border); padding-top: 0.5rem; }
  summary {
    cursor: pointer; font-weight: 600; color: var(--green);
    list-style: none; display: inline-flex; align-items: center; gap: 0.4rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '+'; font-weight: 700; font-size: 1.1em; line-height: 1; }
  details[open] summary::before { content: '–'; }
  summary:hover { color: var(--green-bright); }
  .more { margin-top: 0.75rem; }
  .more :global(p) { margin-bottom: 0.85rem; }

  @media (max-width: 720px) {
    .area, .area--flip { grid-template-columns: 1fr; gap: 1rem; }
    .area--flip .area__media { order: 0; }
    .area__media img { max-width: 480px; }
  }
</style>
